# Polymarket credentials
# Your Ethereum wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Polygon chain ID (137 = mainnet, 80002 = testnet/Amoy)
CHAIN_ID=137

# Polymarket CLOB host
CLOB_HOST=https://clob.polymarket.com

# OpenWeatherMap API key (free tier works)
# Sign up at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Maximum USDC to bet per trade (in whole dollars)
MAX_BET_USDC=10

# Minimum edge required to place a bet (e.g. 0.05 = 5%)
MIN_EDGE=0.05

# Fraction of Kelly criterion to use (0.25 = quarter Kelly for safety)
KELLY_FRACTION=0.25

# Set to "true" to actually place orders, "false" for dry-run only
LIVE_TRADING=false

# ── Cold Email Outreach ──────────────────────────────────────────────────────

# Apollo.io API key (for lead sourcing)
# Get it at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Smartlead API key (for campaign + email sending)
# Get it at: https://app.smartlead.ai/app/settings/api
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# Anthropic API key (for personalised opener generation)
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your name — used as the sign-off in cold emails
SENDER_NAME=Alex
