# ── Binance ──────────────────────────────────────────────────────────────────
# Needs: Spot Trading + Futures Trading enabled
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Bybit ─────────────────────────────────────────────────────────────────────
# Needs: Unified Trading enabled
# https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_SECRET=

# ── OKX ──────────────────────────────────────────────────────────────────────
# Needs: Trade permission, set passphrase below
# https://www.okx.com/account/my-api
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── Gate.io ───────────────────────────────────────────────────────────────────
# Best exchange for PEPE, SHIB, WIF, BONK, DOGE — high altcoin funding rates
# Needs: Spot + Futures trading
# https://www.gate.io/myaccount/apikeys
GATE_API_KEY=
GATE_SECRET=

# ── Hyperliquid (optional) ────────────────────────────────────────────────────
# Decentralised perpetuals — no KYC, often 2–5× CEX rates
# Deposit USDC at app.hyperliquid.xyz
# WALLET = your 0x EVM address
# KEY    = private key hex (no 0x prefix) — keep EXTREMELY secure
# The bot scans Hyperliquid rates and surfaces them as signals.
# Execution = buy spot on Binance/Bybit, short perp on Hyperliquid manually.
HYPERLIQUID_WALLET=
HYPERLIQUID_KEY=

# ── Strategy ──────────────────────────────────────────────────────────────────
MIN_FUNDING_RATE=0.0003       # 0.03%/8h = ~32% APY entry threshold
EXIT_FUNDING_RATE=0.0001      # 0.01%/8h = ~11% APY exit threshold
POSITION_SIZE_USDC=500        # base size per position
MAX_POSITIONS=10              # max simultaneous positions
MAX_TOTAL_USDC=5000           # hard capital cap
SCAN_INTERVAL=60              # seconds between scans

# ── Altcoin filters ───────────────────────────────────────────────────────────
BLACKLIST_BASES=              # e.g. LUNA,FTT (comma-separated, optional)
MIN_MARK_PRICE=0              # minimum mark price; 0 = no filter

# ── Income target (display only) ──────────────────────────────────────────────
TARGET_DAILY_USDC=50

# ── Spike alerts ─────────────────────────────────────────────────────────────
SPIKE_ALERT_RATE=0.002        # 0.2%/8h = ~220% APY

# ── Auto-compounding ──────────────────────────────────────────────────────────
COMPOUND_ENABLED=true
COMPOUND_THRESHOLD=100        # increase position size 10% for each $100 earned

# ── State persistence ─────────────────────────────────────────────────────────
# Written on every position open/close. On restart, the bot knows what is open.
STATE_FILE=./funding_arb_state.json

# ── Position rotation ─────────────────────────────────────────────────────────
# At MAX_POSITIONS, swap the weakest position for one that is ROTATION_THRESHOLD×
# better. MIN_HOLD_PERIODS prevents churning before entry costs are recovered.
ROTATION_ENABLED=true
ROTATION_THRESHOLD=1.5       # new rate must be ≥50% better than worst open rate
MIN_HOLD_PERIODS=2           # hold a position ≥2 funding periods (16h) before rotation

# ── Per-exchange concentration cap ───────────────────────────────────────────
# Never deploy more than this fraction of MAX_TOTAL_USDC on a single exchange.
MAX_EXCHANGE_FRACTION=0.5    # 50% limit — diversify across at least 2 exchanges

# ── Entry quality gate ────────────────────────────────────────────────────────
# Skip entries whose rate can't cover round-trip fees within MAX_BREAKEVEN_PERIODS.
TAKER_FEE_PCT=0.0005         # 0.05% per leg (typical for most exchanges)
MAX_BREAKEVEN_PERIODS=12     # must break even within 12 periods = 4 days

# ── Rate stability filter ─────────────────────────────────────────────────────
# Only enter if the rate has been above MIN_FUNDING_RATE for this many scans.
# Prevents entering on transient 1-scan spikes that immediately revert.
RATE_STABILITY_ENABLED=true
RATE_STABILITY_SCANS=3

# ── Hedge drift monitor ───────────────────────────────────────────────────────
# The spot+perp hedge becomes imperfect as price moves away from your entry.
# Alert at 5% drift; auto-exit at 15% (delta neutrality significantly broken).
HEDGE_DRIFT_ALERT_PCT=0.05
HEDGE_DRIFT_EXIT_PCT=0.15

# ── Circuit breaker ───────────────────────────────────────────────────────────
# If this many positions exit due to rate flips within 1 hour, pause new
# entries. Detects sudden market regime changes (e.g. rates flipping negative).
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_EXITS=3

# ── Trade journal ─────────────────────────────────────────────────────────────
# CSV file where every closed trade is logged for performance tracking.
TRADE_JOURNAL_FILE=./funding_arb_trades.csv

# ── Adaptive scan speed ───────────────────────────────────────────────────────
# Scan faster when under-utilised to catch opportunities sooner.
SCAN_INTERVAL_FAST=30     # seconds when < FAST_SCAN_THRESHOLD fraction full
FAST_SCAN_THRESHOLD=0.5   # 50%: scan fast when fewer than half max positions open

# ── Telegram notifications ────────────────────────────────────────────────────
# 1. Message @BotFather → /newbot → copy token
# 2. Start your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# Leave blank to disable notifications.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live trading ──────────────────────────────────────────────────────────────
LIVE_TRADING=false
