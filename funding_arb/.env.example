# ── Exchange credentials ──────────────────────────────────────────────────────
# Add keys for every exchange you want to trade on.
# Leave blank to use that exchange in read-only / scan mode.

BINANCE_API_KEY=
BINANCE_SECRET=

BYBIT_API_KEY=
BYBIT_SECRET=

OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── Strategy parameters ───────────────────────────────────────────────────────

# Minimum funding rate (per 8h) to enter a position.
# 0.01% per 8h = 13.5% APY. Suggest 0.03–0.05%.
MIN_FUNDING_RATE=0.0003

# Exit when funding rate falls below this (per 8h)
EXIT_FUNDING_RATE=0.0001

# USDC to deploy per position (split evenly across spot + perp)
POSITION_SIZE_USDC=500

# Maximum simultaneous open positions
MAX_POSITIONS=5

# Total capital cap across all positions
MAX_TOTAL_USDC=5000

# How often to scan for new opportunities (seconds)
SCAN_INTERVAL=60

# Set to "true" to place real orders
LIVE_TRADING=false
