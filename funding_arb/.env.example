# =============================================================================
#  FUNDING RATE ARBITRAGE BOT — CONFIGURATION
# =============================================================================
#
#  QUICK START — only ONE number matters for most people:
#
#    MAX_TOTAL_USDC=5000     ← change this to your capital
#
#  Everything else (position size, compound threshold, daily target,
#  circuit breaker) scales automatically.  You do NOT need to touch
#  anything below unless you want to override a specific behaviour.
#
#  Examples:
#    $100   → MAX_TOTAL_USDC=100   (10 positions × $10 each)
#    $500   → MAX_TOTAL_USDC=500   (10 positions × $50 each)
#    $1000  → MAX_TOTAL_USDC=1000  (10 positions × $100 each)
#    $5000  → MAX_TOTAL_USDC=5000  (10 positions × $500 each)
#    $20000 → MAX_TOTAL_USDC=20000 (10 positions × $2000 each)
#
#  Returns scale proportionally at every level.  The same percentage
#  yield on $100 and $20,000 — only the dollar amount differs.
#
#  NOTE: For capital below $200, consider MAX_POSITIONS=5 so each
#  position stays above exchange minimum order sizes (~$10-15 per leg).
# =============================================================================

# ── Capital (the one number to change) ───────────────────────────────────────
MAX_TOTAL_USDC=5000
MAX_POSITIONS=10

# The following are AUTO-DERIVED from MAX_TOTAL_USDC when not set:
#   POSITION_SIZE_USDC  = MAX_TOTAL_USDC / MAX_POSITIONS
#   COMPOUND_THRESHOLD  = MAX_TOTAL_USDC × 2%  (min $2)
#   TARGET_DAILY_USDC   = MAX_TOTAL_USDC × 0.3%  (min $0.10)
#   CIRCUIT_BREAKER_EXITS = MAX_POSITIONS ÷ 3  (min 2)
#
# Uncomment and set only if you want to override the auto-derived values:
# POSITION_SIZE_USDC=500
# COMPOUND_THRESHOLD=100
# TARGET_DAILY_USDC=15
# CIRCUIT_BREAKER_EXITS=3

# ── Exchange API keys ─────────────────────────────────────────────────────────
# Add keys for the exchanges you have accounts on.
# The bot scans all 5 regardless; it only trades on exchanges with keys.

# Binance — Needs: Spot Trading + Futures Trading enabled
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET=

# Bybit — Needs: Unified Trading enabled
# https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_SECRET=

# OKX — Needs: Trade permission + passphrase
# https://www.okx.com/account/my-api
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Gate.io — Best for PEPE, SHIB, WIF, BONK, DOGE (high altcoin rates)
# https://www.gate.io/myaccount/apikeys
GATE_API_KEY=
GATE_SECRET=

# Hyperliquid (optional) — DEX, no KYC, often 2-5× CEX rates
# Scanned for rate signals; execution = buy spot on a CEX, short perp on HL.
# WALLET = your 0x EVM address  |  KEY = private key hex (no 0x prefix)
HYPERLIQUID_WALLET=
HYPERLIQUID_KEY=

# ── Telegram notifications (optional) ────────────────────────────────────────
# Get alerts on your phone for every position open/close/spike.
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start your bot, visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# Leave blank to disable.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Strategy thresholds (safe to leave as-is) ─────────────────────────────────
MIN_FUNDING_RATE=0.0003       # 0.03%/8h ≈ 32% APY entry threshold
EXIT_FUNDING_RATE=0.0001      # 0.01%/8h ≈ 11% APY exit threshold
SCAN_INTERVAL=60              # seconds between scans
COMPOUND_ENABLED=true
LIVE_TRADING=false

# ── Ceiling upgrades (safe defaults — only change if you have a reason) ──────
# MAKER_ORDER_ENABLED=true       # post-only limit orders; auto-falls back to market
# MAKER_FILL_TIMEOUT=20          # seconds to wait for maker fill before market fallback
# MAX_SECTOR_POSITIONS=2         # max positions in same narrative cluster (meme/L1/DeFi…)
# TIMING_GATE_ENABLED=true       # bypass stability scan when funding is imminent (<15 min)
# TIMING_GATE_MINUTES=15         # how close the next payment must be for the gate to fire
# MOMENTUM_FILTER_ENABLED=true   # skip entries where rate is declining rapidly
# MIN_RATE_MOMENTUM=-0.3         # reject if rate has fallen >30% of its own value

# ── Advanced overrides (all auto-derived — only set if you know why) ──────────
# BLACKLIST_BASES=LUNA,FTT    # extra coins to never trade (comma-separated)
# MIN_MARK_PRICE=0            # skip coins below this USDC price (0 = no filter)
# SPIKE_ALERT_RATE=0.002      # 0.2%/8h = 220% APY spike threshold
# ROTATION_ENABLED=true
# ROTATION_THRESHOLD=1.5
# MIN_HOLD_PERIODS=2
# MAX_EXCHANGE_FRACTION=0.5   # max 50% of capital on one exchange
# MAX_ASSET_FRACTION=0.3      # max 30% of capital in one coin
# TAKER_FEE_PCT=0.0005
# MAX_BREAKEVEN_PERIODS=12
# RATE_STABILITY_ENABLED=true
# RATE_STABILITY_SCANS=3
# RATE_HISTORY_SAMPLES=40       # rolling window for consistency stats
# RATE_CV_FILTER_ENABLED=true   # require steady (low-volatility) rates
# MAX_RATE_CV=1.0               # max std/mean; lower = stricter consistency
# COOLDOWN_ENABLED=true         # block re-entry of a coin after it exits
# COOLDOWN_HOURS=2              # how long the cooldown lasts
# BALANCE_AWARE_SIZING=false    # size from real exchange balance (live only)
# BALANCE_FRACTION=0.10         # fraction of free balance per position
# EQUITY_CURVE_FILE=./funding_arb_equity.csv
# EQUITY_SNAPSHOT_HOURS=1       # how often to log an equity-curve row
# TRAILING_RATE_STOP=0.5
# HEDGE_DRIFT_ALERT_PCT=0.05
# HEDGE_DRIFT_EXIT_PCT=0.15
# PERP_LEVERAGE=1
# MARGIN_ALERT_RATIO=0.5
# MARGIN_EXIT_RATIO=0.8
# CIRCUIT_BREAKER_ENABLED=true
# SCAN_INTERVAL_FAST=30
# FAST_SCAN_THRESHOLD=0.5
# STATE_FILE=./funding_arb_state.json
# TRADE_JOURNAL_FILE=./funding_arb_trades.csv
