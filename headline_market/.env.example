# How many days the market stays open before resolving NO
MARKET_DURATION_DAYS=7

# How often to scan headlines (seconds)
POLL_INTERVAL=120

# Comma-separated words that must ALL appear in a single headline
TRIGGER_WORDS=trump,iran,israel

# ── Polymarket betting (optional) ────────────────────────────────────
# Leave blank to run in dry-run mode (no real bets)
POLY_PRIVATE_KEY=0x_your_private_key_here
POLY_FUNDER_ADDRESS=0x_your_funder_address_here

# USDC to bet per matched Polymarket market when signal fires
BET_AMOUNT_USDC=10

# Only bet on YES prices within this range (skip near-certain markets)
MIN_YES_PRICE=0.05
MAX_YES_PRICE=0.80

# Set to "true" to place real orders, "false" for dry-run
LIVE_BETTING=false
