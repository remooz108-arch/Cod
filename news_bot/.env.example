# Alpaca API (paper trading: https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# "paper" or "live"
ALPACA_MODE=paper

# NewsAPI key (optional — RSS feeds work without it)
# Free at https://newsapi.org/register (100 req/day free)
NEWS_API_KEY=

# How often to scan for new articles (seconds)
POLL_INTERVAL=300

# Risk per triggered trade in USD
RISK_PER_TRADE_USD=100

# Maximum shares per position (safety cap)
MAX_SHARES=50

# Cooldown between trades on the same ticker (seconds)
TRADE_COOLDOWN=3600

# Set to "true" to actually submit orders
LIVE_ORDERS=false
