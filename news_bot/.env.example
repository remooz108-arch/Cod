# Polymarket credentials (for placing bets)
# Paper/no-wallet needed for --scan-only mode
POLY_PRIVATE_KEY=0x_your_private_key_here
POLY_FUNDER_ADDRESS=0x_your_funder_address_here

# Max USDC to bet per triggered signal
BET_AMOUNT_USDC=10

# How often to scan headlines (seconds)
POLL_INTERVAL=120

# Set to "true" to actually place orders on Polymarket
LIVE_BETTING=false

# Optional: comma-separated extra keywords to narrow market search
# e.g. "war,attack,strike,nuclear"
MARKET_KEYWORDS=war,attack,strike,conflict,military
