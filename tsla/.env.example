# Alpaca API credentials
# Paper trading keys (free): https://app.alpaca.markets/paper/dashboard/overview
# Live trading keys:          https://app.alpaca.markets/brokerage/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# "paper" uses paper-api.alpaca.markets (no real money)
# "live"  uses api.alpaca.markets (real money)
ALPACA_MODE=paper

# Max dollars you are willing to lose on this trade
RISK_PER_TRADE_USD=100

# Hard cap on shares (safety guard)
MAX_SHARES=50

# Minimum 2-minute price move required to take the trade (in dollars)
# Avoids trading on tiny, noisy moves
MIN_MOVE_USD=0.15

# Set to "true" to actually submit orders, "false" to print and stop
LIVE_ORDERS=false
